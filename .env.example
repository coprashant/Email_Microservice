PORT=3000
NODE_ENV=production

# Multi account JSON configuration
GMAIL_ACCOUNTS='{"otp_service":{"clientId":"ID_1","clientSecret":"SEC_1","refreshToken":"TOKEN_1","userEmail":"otp@domain.com","senderName":"Auth System"},"billing_service":{"clientId":"ID_2","clientSecret":"SEC_2","refreshToken":"TOKEN_2","userEmail":"billing@domain.com","senderName":"Billing Team"}}'

# Legacy single account configuration fallback
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_USER_EMAIL=your-account@gmail.com

DEFAULT_SENDER_NAME=No-Reply
SERVICE_API_KEY=replace_with_a_long_random_secret
ALLOWED_ORIGINS=*