# Server configuration
PORT=3000
NODE_ENV=production

# Gmail api oauth2 credentials
# See oauth setup guide for instructions to obtain values
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_USER_EMAIL=your-account@gmail.com

# Optional default from display name when request has no sendername
DEFAULT_SENDER_NAME=No-Reply

# Service security
# Generate a strong random value using node crypto randombytes
SERVICE_API_KEY=replace_with_a_long_random_secret

# Cors comma separated list of allowed origins
# Use wildcard for all origins only when risk is accepted
ALLOWED_ORIGINS=*
