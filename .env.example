# ---------------------------------------------------
# Server Configuration
# ---------------------------------------------------
PORT=3000
NODE_ENV=production

# ---------------------------------------------------
# Gmail API (OAuth2) Credentials
# See OAUTH_SETUP.md for step-by-step instructions on
# how to obtain these values.
# ---------------------------------------------------
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_USER_EMAIL=your-account@gmail.com

# Optional: default "From" display name used when a request
# does not provide a senderName field
DEFAULT_SENDER_NAME=No-Reply

# ---------------------------------------------------
# Service Security
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------
SERVICE_API_KEY=replace_with_a_long_random_secret

# ---------------------------------------------------
# CORS (comma-separated list of allowed origins)
# Use "*" to allow all origins (not recommended for prod)
# ---------------------------------------------------
ALLOWED_ORIGINS=*
